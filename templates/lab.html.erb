<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Lab <%= lab.number %> - Git Immersion</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0 viewport-fit=cover"">
    <meta name="description" content="Un recorrido guiado por los fundamentos de Git">
    <meta name="theme-color" content="#0000ff">
    <link rel="manifest" href="manifest.json">
    <link rel="stylesheet" media="screen" href="reset.css"> 
    <link rel="stylesheet" media="screen" href="screen.css"> 
    <script type="text/javascript" src="UI.js"></script>
  </head>

  <body data-lab-id="<%= lab.number %>">
    <a href="#content" tabindex="1" class="skip-to-content">
      Saltar al contenido
    </a>

    <div class="layout">
      <div id="index">
        <p class="link-home">
          <a href="index.html"><span>Git Immersion</span></a>
        </p>
        <button class="link-menu">Menú</button>
        <nav tabindex="0">
          <ol>
            <%= lab_index(f, labs) %>
          </ol>
        </nav>
      </div>

      <div id="content" tabindex="-1">
        <%= lab_html %>
        <%= nav_links(f, lab) %>
      </div>
    </div>
  </body>
</html>
